// Vigil DSL Guard Grammar
// Formal grammar for admitted transition-guard and state-invariant clauses.
// Parsed by lark-parser during symbolic verification and offline guardrail construction.
//
// Predicates:
//   read(element, property) op value   - read UI element property
//   value(element) op value            - read the widget's semantic value
//   count(element) op value            - child count of element
//   action(property) op value          - proposed action property check
//   contains / not_contains            - containment operators over text/list values
// Property/operator type compatibility is enforced by typed admission, not syntax.

start: guard

guard: predicate
     | predicate "&&" guard

predicate: read_pred | value_pred | count_pred | action_pred

read_pred: "read(" ELEMENT "," PROPERTY ")" OP VALUE
value_pred: "value(" ELEMENT ")" OP VALUE
count_pred: "count(" ELEMENT ")" OP VALUE
action_pred: "action(" PROPERTY ")" OP VALUE

OP: "==" | "!=" | ">" | "<" | ">=" | "<=" | "contains" | "not_contains"

ELEMENT: /[a-zA-Z_][a-zA-Z0-9_.:\/]*/
PROPERTY: /[a-zA-Z_][a-zA-Z0-9_]*/
VALUE: ESCAPED_STRING | NUMBER | "true" | "false" | INTENT_VAR
INTENT_VAR: /\$intent\.[a-zA-Z_][a-zA-Z0-9_]*/
%import common.ESCAPED_STRING
%import common.NUMBER
%import common.WS
%ignore WS
